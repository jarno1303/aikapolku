<?xml version="1.0" encoding="utf-8"?>
<!--
  Asiakkaiden tiedot eivät lähde laitteelta: ei Googlen pilvivarmuuskopiota eikä
  laitteesta laitteeseen -siirtoa. Laitteen vaihto tehdään sovelluksen omalla viennillä.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
